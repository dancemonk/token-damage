# Cloudflare Pages response headers (docs/PRIVACY.md §Threat model). The pages carry their own
# Content-Security-Policy in a meta tag; framing can only be refused here, as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Fonts and preview images change rarely; their names aren't hashed, so a month, not forever.
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=86400
