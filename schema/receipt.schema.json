{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokendamage.com/schema/receipt.schema.json",
  "title": "Token Damage receipt",
  "description": "`token-damage --json`. Every number carries its truth tier (docs/METRICS.md). No text from prompts, no paths, no project names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "trans",
    "period",
    "measured",
    "byAgent",
    "byModel",
    "priced",
    "estimated",
    "satire",
    "damageClass",
    "note",
    "achievements",
    "jokes",
    "poolSatire",
    "news",
    "method"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "trans": {
      "type": "string",
      "pattern": "^\\d{4,}$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "days",
        "retentionDays",
        "retentionIsDefault"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/day"
        },
        "end": {
          "$ref": "#/$defs/day"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "retentionIsDefault": {
          "type": "boolean"
        }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "words",
        "prompts",
        "calls",
        "sessions",
        "activeDays",
        "subagents",
        "byType",
        "tokensRead",
        "cacheReadShare",
        "freshShare",
        "outputShare",
        "tokensWritten",
        "latestCall",
        "latestCallDay",
        "longestSessionMinutes"
      ],
      "properties": {
        "words": {
          "$ref": "#/$defs/measured"
        },
        "prompts": {
          "$ref": "#/$defs/measured"
        },
        "calls": {
          "$ref": "#/$defs/measured"
        },
        "sessions": {
          "$ref": "#/$defs/measured"
        },
        "activeDays": {
          "$ref": "#/$defs/measured"
        },
        "subagents": {
          "$ref": "#/$defs/measured"
        },
        "byType": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cacheWrite", "cacheRead", "output"],
          "properties": {
            "input": {
              "$ref": "#/$defs/measured"
            },
            "cacheWrite": {
              "$ref": "#/$defs/measured"
            },
            "cacheRead": {
              "$ref": "#/$defs/measured"
            },
            "output": {
              "$ref": "#/$defs/measured"
            }
          }
        },
        "tokensRead": {
          "$ref": "#/$defs/measured"
        },
        "cacheReadShare": {
          "$ref": "#/$defs/measured"
        },
        "freshShare": {
          "$ref": "#/$defs/measured"
        },
        "outputShare": {
          "$ref": "#/$defs/measured"
        },
        "tokensWritten": {
          "$ref": "#/$defs/measured"
        },
        "latestCall": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "tier"],
              "properties": {
                "value": {
                  "type": "string"
                },
                "tier": {
                  "const": "measured"
                }
              }
            }
          ]
        },
        "latestCallDay": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/day"
            }
          ]
        },
        "longestSessionMinutes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/measured"
            }
          ]
        }
      }
    },
    "byAgent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "tokens", "listPrice"],
        "properties": {
          "agent": {
            "enum": ["claude-code", "codex", "gemini", "opencode"]
          },
          "tokens": {
            "$ref": "#/$defs/measured"
          },
          "listPrice": {
            "$ref": "#/$defs/priced"
          },
          "estModel": {
            "const": true
          },
          "notPriced": {
            "const": true
          },
          "partlyPriced": {
            "const": true
          }
        }
      }
    },
    "byModel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tokens", "listPrice"],
        "properties": {
          "name": {
            "type": "string"
          },
          "tokens": {
            "$ref": "#/$defs/measured"
          },
          "listPrice": {
            "$ref": "#/$defs/priced"
          },
          "estModel": {
            "const": true
          },
          "notPriced": {
            "const": true
          },
          "partlyPriced": {
            "const": true
          }
        }
      }
    },
    "priced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listPrice",
        "plan",
        "cacheSaved",
        "withoutCache",
        "mostExpensiveDay"
      ],
      "properties": {
        "listPrice": {
          "$ref": "#/$defs/priced"
        },
        "partlyPriced": {
          "const": true
        },
        "plan": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["usd", "multiple"],
              "properties": {
                "usd": {
                  "type": "number",
                  "minimum": 0
                },
                "multiple": {
                  "$ref": "#/$defs/priced"
                }
              }
            }
          ]
        },
        "cacheSaved": {
          "$ref": "#/$defs/priced"
        },
        "withoutCache": {
          "$ref": "#/$defs/priced"
        },
        "mostExpensiveDay": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["day", "listPrice"],
              "properties": {
                "day": {
                  "$ref": "#/$defs/day"
                },
                "listPrice": {
                  "$ref": "#/$defs/priced"
                }
              }
            }
          ]
        }
      }
    },
    "estimated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electricityKwh",
        "comparison",
        "waterLiters",
        "co2Kg",
        "typingShare"
      ],
      "properties": {
        "electricityKwh": {
          "$ref": "#/$defs/estimated"
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": ["fridge-months", "phone-charges"]
            },
            "value": {
              "$ref": "#/$defs/estimated"
            }
          }
        },
        "waterLiters": {
          "$ref": "#/$defs/estimated"
        },
        "co2Kg": {
          "$ref": "#/$defs/estimated"
        },
        "typingShare": {
          "$ref": "#/$defs/estimated"
        }
      }
    },
    "satire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ramX"],
      "properties": {
        "ramX": {
          "$ref": "#/$defs/satire"
        }
      }
    },
    "damageClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "finePrint"],
      "properties": {
        "name": {
          "enum": [
            "PAPER CUT",
            "FENDER BENDER",
            "WATER DAMAGE",
            "STRUCTURAL",
            "ACT OF GOD",
            "UNINSURABLE"
          ]
        },
        "finePrint": {
          "type": "string"
        }
      }
    },
    "note": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "variant", "text"],
          "properties": {
            "family": {
              "type": "string"
            },
            "variant": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "trigger", "hidden"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "jokes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "poolSatire": {
      "description": "One ✶ pool line: a real AI event and the reader's made-up share of it.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "required": ["date", "url"],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "news": {
      "description": "One dated AI news line from the pool, plain fact.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "required": ["date", "url"],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pricesAsOf"],
      "properties": {
        "version": {
          "const": "v1"
        },
        "pricesAsOf": {
          "$ref": "#/$defs/day"
        }
      }
    }
  },
  "$defs": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tier"],
      "properties": {
        "value": {
          "type": "number"
        },
        "tier": {
          "enum": ["measured", "priced", "estimated", "satire"]
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "measured": {
      "allOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "properties": {
            "tier": {
              "const": "measured"
            }
          }
        }
      ]
    },
    "priced": {
      "allOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "properties": {
            "tier": {
              "const": "priced"
            }
          }
        }
      ]
    },
    "estimated": {
      "allOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "required": ["low", "high"],
          "properties": {
            "tier": {
              "const": "estimated"
            }
          }
        }
      ]
    },
    "satire": {
      "allOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "required": ["note"],
          "properties": {
            "tier": {
              "const": "satire"
            },
            "note": {
              "pattern": "made up"
            }
          }
        }
      ]
    }
  }
}
