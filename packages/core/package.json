{
  "name": "@token-damage/core",
  "version": "0.3.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./pool": {
      "types": "./dist/pool-entry.d.ts",
      "default": "./dist/pool-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:big": "TD_BIG_MB=512 vitest run test/claude/big-file.test.ts",
    "sanitize-fixture": "node --experimental-strip-types scripts/sanitize-fixture.ts",
    "opencode-fixture": "node --experimental-strip-types scripts/opencode-fixture.ts",
    "sample-month": "node --experimental-strip-types scripts/sample-month.ts"
  },
  "files": [
    "dist"
  ],
  "description": "Parsing, dedupe, metrics, the live engine and the roast engine behind token-damage. Zero runtime dependencies.",
  "homepage": "https://tokendamage.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dancemonk/token-damage.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dancemonk/token-damage/issues"
  },
  "author": "Vlad Guliakin",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
