{
  "name": "@token-damage/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:big": "TD_BIG_MB=512 vitest run test/claude/big-file.test.ts",
    "sanitize-fixture": "node --experimental-strip-types scripts/sanitize-fixture.ts",
    "sample-month": "node --experimental-strip-types scripts/sample-month.ts"
  },
  "files": [
    "dist"
  ],
  "description": "Parsing, dedupe, metrics and the roast engine behind token-damage. Zero runtime dependencies.",
  "homepage": "https://github.com/dancemonk/token-damage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dancemonk/token-damage.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dancemonk/token-damage/issues"
  },
  "author": "Vlad Guliakin",
  "license": "MIT"
}
