{
  "name": "token-damage",
  "version": "0.3.1",
  "description": "The receipt your AI agent never gave you. Reads the local logs of Claude Code, Codex, Gemini CLI and OpenCode and prints an itemized receipt, or watches today live. Uploads nothing.",
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "tokens",
    "usage",
    "receipt",
    "statusline",
    "cli",
    "ai",
    "llm"
  ],
  "homepage": "https://tokendamage.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dancemonk/token-damage.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dancemonk/token-damage/issues"
  },
  "author": "Vlad Guliakin",
  "license": "MIT",
  "type": "module",
  "bin": {
    "token-damage": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@token-damage/core": "workspace:*"
  }
}
